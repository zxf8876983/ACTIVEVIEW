    "experiment_id": "EXP001",
    "name": "gap_aware_ranking",
    "stage": "stage_c_v1",
    "status": "PLANNED",
    "hypothesis": "Stage C-v0 的高 regret 部分源于训练目标未充分强调大 utility gap；加入 utility-gap-aware pairwise ranking term 将在不改变输入与架构的情况下改善 Val 的 regret/headroom，同时保持或提升 recognition metrics。",
    "motivation": "Stage C-v0 在 Test 上 exact candidate hit 较低且 regret 右偏；高 utility-gap 错选是更值得惩罚的候选排序错误。该实验只在 Val 上检验这一单一目标函数假设。",
    "baseline": "Stage C-v0 SetUtilityRanker with SmoothL1 regression plus stay-inclusive listwise ranking",
    "core_change": "Add one stay-inclusive utility-gap-weighted pairwise ranking term to the existing Set Ranker objective; no architecture, feature, sampler, or upstream protocol change.",
    "frozen_items": [
      "Stage A",
      "Stage B",
      "Stage C features",
      "frozen ST-GCN",
      "record split"
    ],
    "metrics": [
      "Accuracy",
      "Macro-F1",
      "mean/median/p90 regret",
      "positive headroom capture"
    ],
    "acceptance_criteria": [
      "Val large-gap utility-quartile mean regret decreases by at least 5%",
      "At least one of C2 high-loss rate, Val p90 regret, or positive-headroom capture improves",
      "Val Macro-F1 decreases by no more than 0.5 percentage points",
      "All frozen-artifact, split, leakage and provenance checks pass",
      "test_used remains false"
    ],
    "rejection_criteria": [
      "Large-gap mean regret fails to improve by 5% and other harmful-ranking diagnostics show no consistent improvement"
    ],
